{
  "networkPolicy": {
    "default": "deny",
    "allow": [
      "github.com",
      "api.github.com",
      "registry.npmjs.org",
      "registry.yarnpkg.com",
      "pkg.go.dev",
      "proxy.golang.org",
      "crates.io",
      "pypi.org",
      "files.pythonhosted.org",
      "*.docker.io",
      "ghcr.io"
    ],
    "deny": [
      "*.internal.corp.example.com"
    ]
  },
  "additionalReadwritePaths": [
    "/home/me/.docker"
  ],
  "additionalReadonlyPaths": [
    "/opt/shared/design-tokens"
  ],
  "enableSharedBuildCache": false
}